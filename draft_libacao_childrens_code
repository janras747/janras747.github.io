		 <style>

			/* ==========================================================================
				0. HERO HEADER (Document Title)
				========================================================================== */
			.page-header {
			position: sticky;
			top: 0;
			z-index: 900; /* Keeps it above text, but below the 1000 z-index sidebar */
			
			/* Slimmer Spacing */
			padding: 0.8rem 2rem;
			
			/* Glassmorphism effect: slightly transparent dark background with a blur */
			background-color: rgba(30, 41, 59, 0.95);
			backdrop-filter: blur(8px);
			-webkit-backdrop-filter: blur(8px);
			
			/* Borders */
			border-top: 4px solid #38bdf8;
			border-bottom: 1px solid #334155;
			text-align: center;
			}

			.page-header h1 {
			color: #f8fafc;
			font-size: 2.2rem;
			margin: 0 0 0.5rem 0;
			font-weight: 700;
			}

			.page-header p {
			color: #94a3b8;
			font-size: 1.1rem;
			margin: 0;
			}

			/* ==========================================================================
				1. GLOBAL & SCROLL SETTINGS
				========================================================================== */
			html {
			/* Enables smooth gliding when an anchor link is clicked */
			scroll-behavior: smooth;
			}

			body {
			margin: 0;
			font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
			background-color: #0f172a;
			color: #e2e8f0;
			line-height: 1.6;
			}

			/* Target offset so section titles aren't hidden by the sticky header */
			article[id], h1[id], h2[id], section[id] {
			scroll-margin-top: 6rem; 
			}

			p[id] {
			scroll-margin-top: 8rem; 
			}

			/* ==========================================================================
				2. FIXED SIDEBAR LAYOUT
				========================================================================== */
			.sidebar {
			position: fixed;
			top: 0;
			left: 0;
			width: 33.33vw;
			min-width: 260px;
			max-width: 450px;
			height: 100vh;
			background-color: #1a1a24;
			box-shadow: 6px 0 20px rgba(0, 0, 0, 0.4);
			z-index: 1000;

			/* REMOVED overflow here so the hamburger tab isn't clipped */
			transform: translateX(-100%);
			transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
			}

			/* Webkit Scrollbar Styling */
			.sidebar::-webkit-scrollbar { width: 6px; }
			.sidebar::-webkit-scrollbar-thumb { background-color: #334155; border-radius: 3px; }

			/* ==========================================================================
				3. TOGGLE MECHANISMS (HOVER + CLICK)
				========================================================================== */

			/* Hover Trigger (Desktop only) */
			@media (hover: hover) {
			.sidebar:hover {
				transform: translateX(0);
			}
			}

			/* Click Trigger via Hidden Checkbox (Mobile/Touch) */
			#sidebar-toggle:checked ~ .sidebar {
			transform: translateX(0);
			}

			/* Hamburger Tab Handle attached to the right edge */
			.sidebar-tab {
			position: absolute;
			top: 50%;
			right: -48px; /* Pulls handle completely outside the hidden sidebar */
			width: 48px;
			height: 90px;
			background-color: #1a1a24;
			border-radius: 0 10px 10px 0;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 5px;
			cursor: pointer;
			transform: translateY(-50%);
			box-shadow: 4px 0 12px rgba(0, 0, 0, 0.25);
			}

			/* Hamburger Icon Lines */
			.hamburger-line {
			width: 20px;
			height: 2px;
			background-color: #38bdf8;
			border-radius: 2px;
			}

			/* ==========================================================================
				4. HIERARCHICAL INDEX MENU
				========================================================================== */
			.sidebar-content {
			padding: 2rem 1.5rem;
			
			/* MOVED scrolling rules here */
			height: 100vh;
			box-sizing: border-box;
			overflow-y: auto; 
			scrollbar-width: thin;
			scrollbar-color: #334155 transparent;
			}

			/* Webkit Scrollbar Styling moved to content */
			.sidebar-content::-webkit-scrollbar { width: 6px; }
			.sidebar-content::-webkit-scrollbar-thumb { background-color: #334155; border-radius: 3px; }

			.sidebar-content h2 {
			font-size: 1.2rem;
			color: #f8fafc;
			border-bottom: 1px solid #334155;
			padding-bottom: 0.75rem;
			margin-top: 0;
			margin-bottom: 1.5rem;
			}

			.article-accordion {
			margin-bottom: 1.25rem;
			}

			/* Article Titles (Click to expand menu) */
			.article-accordion summary {
			cursor: pointer;
			font-weight: 600;
			font-size: 1rem;
			color: #f1f5f9;
			user-select: none;
			padding: 0.25rem 0;
			list-style-position: inside;
			}

			.article-accordion summary:hover {
			color: #38bdf8;
			}

			/* Article Links inside Summary (Click to scroll page) */
			.article-accordion summary a {
			color: inherit;
			text-decoration: none;
			}

			/* Nested Section List */
			.section-list {
			list-style: none;
			padding: 0 0 0 1rem;
			margin: 0.5rem 0 0 0.25rem;
			border-left: 2px solid #334155; /* Visual indentation line */
			}

			.section-list li {
			margin-bottom: 0.6rem;
			}

			.section-list a {
			font-size: 0.9rem;
			color: #94a3b8;
			text-decoration: none;
			display: inline-block;
			transition: color 0.2s, transform 0.2s;
			}

			.section-list a:hover {
			color: #38bdf8;
			transform: translateX(4px);
			}

			/* ==========================================================================
				5. MAIN PAGE CONTENT STYLES
				========================================================================== */
			.content-container {
			/* Pushes content to the right to leave room when sidebar is open */
			margin-left: auto;
			margin-right: auto;
			max-width: 800px;
			padding: 4rem 2rem;
			}

			.article-card {
			background-color: #1e293b;
